    {
      "parameters": {
        "jsCode": "const aiOutput = $input.first().json.output?.[0]?.content?.[0]?.text || '';\nconst allEvents = $('Prepare Summary Events').first().json.all_events || [];\n\nconst tableRows = allEvents.map((e, i) => `\n  <tr>\n    <td style=\"padding:6px;border:1px solid #ddd\">${i + 1}</td>\n    <td style=\"padding:6px;border:1px solid #ddd\">${e.event_date || ''}</td>\n    <td style=\"padding:6px;border:1px solid #ddd\">${e.supplier_name || ''}</td>\n    <td style=\"padding:6px;border:1px solid #ddd\">${e.risk_title || ''}</td>\n    <td style=\"padding:6px;border:1px solid #ddd\">${e.risk_category || ''}</td>\n    <td style=\"padding:6px;border:1px solid #ddd\">${e.overall_risk_score || ''}</td>\n    <td style=\"padding:6px;border:1px solid #ddd\">\n      ${e.source_url\n        ? `<a href=\"${e.source_url}\" target=\"_blank\">Open Source</a>`\n        : 'No source link'}\n    </td>\n  </tr>\n`).join('');\n\nconst sourceEventsSection = allEvents.length > 0\n  ? `\n<h3>📋 Source Events (Verified Data)</h3>\n<table style=\"border-collapse:collapse;width:100%;font-size:13px\">\n  <thead>\n    <tr style=\"background:#f2f2f2\">\n      <th style=\"padding:6px;border:1px solid #ddd\">#</th>\n      <th style=\"padding:6px;border:1px solid #ddd\">Date</th>\n      <th style=\"padding:6px;border:1px solid #ddd\">Supplier</th>\n      <th style=\"padding:6px;border:1px solid #ddd\">Risk Title</th>\n      <th style=\"padding:6px;border:1px solid #ddd\">Category</th>\n      <th style=\"padding:6px;border:1px solid #ddd\">Score</th>\n      <th style=\"padding:6px;border:1px solid #ddd\">Source</th>\n    </tr>\n  </thead>\n  <tbody>\n    ${tableRows}\n  </tbody>\n</table>`\n  : `\n<h3>📋 Source Events (Verified Data)</h3>\n<p>No qualifying supply chain risk events were identified during this reporting period.</p>`;\n\nconst emailBody = `\n<h2>📊 Daily Supply Chain Risk Summary</h2>\n<p><i>Generated by AI Supply Chain Risk Intelligence Platform</i></p>\n<hr>\n\n<h3>🤖 AI Executive Summary</h3>\n<div style=\"white-space: pre-wrap; line-height:1.6; font-family:Arial,sans-serif;\">\n${aiOutput\n  .replace(/Executive Summary/g, '<b>1. Executive Summary</b>')\n  .replace(/Top Risks/g, '<b>2. Top Risks</b>')\n  .replace(/Recommended Actions/g, '<b>3. Recommended Actions</b>')}\n</div>\n\n<hr>\n\n${sourceEventsSection}\n\n<hr>\n<p><i>This email was sent automatically by AI Supply Chain Risk Intelligence Platform</i></p>\n`;\n\nreturn [{\n  json: {\n    email_body: emailBody,\n    event_count: allEvents.length\n  }\n}];"
      },
