    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst now = new Date();\n\nconst filtered = items.filter(item => {\n  const alertLevel = item.json.alert_level || '';\n  const status = item.json.summary_status || '';\n  const eventDate = item.json.event_date;\n\n  if (alertLevel !== 'summary') return false;\n  if (status !== 'pending') return false;\n\n  if (eventDate) {\n    const eventTime = new Date(eventDate);\n    const hoursOld = (now - eventTime) / (1000 * 60 * 60);\n\n    // 本番用：直近72時間のみ\n    if (hoursOld > 72) return false;\n  }\n\n  return true;\n});\n\nconst events = filtered.map(item => ({\n  row_number: item.json.row_number,\n  event_date: item.json.event_date,\n  supplier_name: item.json.supplier_name,\n  risk_title: item.json.risk_title,\n  risk_category: item.json.risk_category,\n  overall_risk_score: item.json.overall_risk_score,\n  ai_summary: item.json.ai_summary,\n  recommended_action: item.json.recommended_action,\n  source_url: (item.json.source_url || '').split('?')[0] || item.json.source_url\n}));\n\n// AI用：対象イベントをすべて渡す\nconst aiEvents = events;\n\nconst promptText = `You are a Supply Chain Risk Analyst.\n\nUse ONLY the data provided below.\nNever invent suppliers, risks, scores, summaries, or URLs.\n\nInput Events:\n${JSON.stringify(aiEvents, null, 2)}\n\nGenerate the following sections using ONLY the above data:\n\n1. Executive Summary\n\n2. Top Risks\n\n3. Recommended Actions\n\nIMPORTANT EMAIL FORMATTING RULES:\n\n- Do NOT use markdown symbols like #, ##, ###, *, or -\n- Use short readable paragraphs\n- Add blank lines between sections\n- Keep formatting readable in Gmail HTML emails\n- Use professional executive business English\n- Keep the summary concise and readable\n- Do NOT repeat the same sentence patterns\n- Do NOT generate fake examples\n- Use actual supplier names from Input Events\n- Use actual risk titles from Input Events\n- Use actual scores from Input Events\n\nFor Top Risks include:\n- Supplier Name\n- Risk Title\n- Overall Risk Score\n- One-line Operational Impact\n\nFor Recommended Actions:\n- Use ONLY the provided recommended_action values\n- Summarize similar actions when possible\n\nKeep the final output concise enough for executive email reading.`;\n\nreturn [{\n  json: {\n    event_count: events.length,\n    all_events: events,\n    prompt_text: promptText\n  }\n}];"
      },
