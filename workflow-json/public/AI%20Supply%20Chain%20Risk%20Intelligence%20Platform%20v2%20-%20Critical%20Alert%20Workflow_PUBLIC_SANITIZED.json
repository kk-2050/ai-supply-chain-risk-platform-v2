      "name": "Prepare AI Risk Prompt"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "GPT-4O-MINI"
        },
        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You are a supply chain risk analyst.\n\nAnalyze the given supplier risk news and return ONLY valid JSON.\n\nRequired JSON fields:\n- risk_title\n- risk_category\n- severity_score\n- operational_impact_score\n- urgency_score\n- confidence_score\n- ai_summary\n- recommended_action\n\nRules:\n- severity_score: 1-5\n- operational_impact_score: 1-5\n- urgency_score: 1-5\n- confidence_score: 0-100\n- Return only JSON\n- No markdown\n- No explanation"
            },
            {
              "content": "=Supplier: {{ $json.supplier_name }}\nText: {{ $json.raw_text }}"
            }
          ]
        },
        "simplify": false,
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.1,
      "position": [
        2000,
        -128
      ],
      "id": "832209b0-27c1-4a5a-8165-49d94a3f8dae",
      "name": "Generate AI Risk Assessment",
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_WITH_OPENAIAPI_ID",
          "name": "Configure openAiApi credential in n8n"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Ensure we handle multiple input items correctly by processing as an array\nreturn $input.all().map((item, index) => {\n  const input = item.json;\n\n  const aiRaw =\n    input?.output?.[0]?.content?.[0]?.text ||\n    input.message?.content ||\n    input.content ||\n    input.text ||\n    input.response ||\n    JSON.stringify(input);\n\n  let aiData;\n  let parseFailed = false;\n  let parseErrorMessage = '';\n\n  try {\n    aiData = typeof aiRaw === 'string' ? JSON.parse(aiRaw) : aiRaw;\n  } catch (e) {\n    parseFailed = true;\n    parseErrorMessage = 'AI output failed JSON parsing (SyntaxError)';\n    aiData = {\n      risk_title: 'Parse error - manual review needed',\n      risk_category: 'Other',\n      severity_score: 1,\n      operational_impact_score: 1,\n      urgency_score: 1,\n      confidence_score: 0,\n      ai_summary: 'AI output could not be parsed. Manual review is required.',\n      recommended_action: 'Review the workflow execution and AI response manually.'\n    };\n  }\n\n  // Safely pull the corresponding item from upstream nodes using the item index\n  let supplierData = {};\n  try {\n    supplierData = $('Prepare AI Risk Prompt').all()[index]?.json || {};\n  } catch (e) {\n    try {\n      supplierData = $('Match Supplier And Clean News').all()[index]?.json || {};\n    } catch (err) {\n      supplierData = {};\n    }\n  }\n\n  const severity = Number(aiData.severity_score) || 1;\n  const impact = Number(aiData.operational_impact_score) || 1;\n  const urgency = Number(aiData.urgency_score) || 1;\n\n  const overall = (\n    severity * 0.40 +\n    impact * 0.35 +\n    urgency * 0.25\n  ).toFixed(2);\n\n  const rawCategory = String(aiData.risk_category || '').toLowerCase();\n\n  function standardizeCategory(category) {\n    if (\n      category.includes('shortage') ||\n      category.includes('supply risk') ||\n      category.includes('market supply') ||\n      category.includes('material') ||\n      category.includes('resource') ||\n      category.includes('semiconductor supply') ||\n      category.includes('supply chain disruption')\n    ) {\n      return 'Supply Shortage';\n    }\n\n    if (\n      category.includes('geopolitical') ||\n      category.includes('political') ||\n      category.includes('war') ||\n      category.includes('conflict') ||\n      category.includes('sanction')\n    ) {\n      return 'Geopolitical';\n    }\n\n    if (\n      category.includes('tariff') ||\n      category.includes('trade') ||\n      category.includes('duty')\n    ) {\n      return 'Tariff';\n    }\n\n    if (\n      category.includes('logistics') ||\n      category.includes('shipping') ||\n      category.includes('freight') ||\n      category.includes('port') ||\n      category.includes('transport')\n    ) {\n      return 'Logistics';\n    }\n\n    if (\n      category.includes('financial') ||\n      category.includes('cost') ||\n      category.includes('price') ||\n      category.includes('currency')\n    ) {\n      return 'Financial';\n    }\n\n    if (\n      category.includes('cyber') ||\n      category.includes('hack') ||\n      category.includes('security')\n    ) {\n      return 'Cybersecurity';\n    }\n\n    if (\n      category.includes('natural disaster') ||\n      category.includes('earthquake') ||\n      category.includes('flood') ||\n      category.includes('typhoon') ||\n      category.includes('hurricane')\n    ) {\n      return 'Natural Disaster';\n    }\n\n    if (\n      category.includes('operational') ||\n      category.includes('shutdown') ||\n      category.includes('factory')\n    ) {\n      return 'Operational Disruption';\n    }\n\n    return 'Other';\n  }\n\n  const standardCategory = standardizeCategory(rawCategory);\n\n  const processedAt = (() => {\n    const now = new Date();\n\n    const chicago = new Intl.DateTimeFormat('en-CA', {\n      timeZone: 'America/Chicago',\n      year: 'numeric',\n      month: '2-digit',\n      day: '2-digit',\n      hour: 'numeric',\n      minute: '2-digit',\n      hour12: true\n    }).format(now);\n\n    return chicago.replace(',', '') + ' CST';\n  })();\n\n  // Get the reliable source URL from upstream news processors\n  const finalSourceUrl = supplierData?.source_url || input?.source_url || \"https://news.google.com\";\n\n  return {\n    json: {\n      supplier_id: supplierData?.supplier_id || \"SUPP_DEFAULT\",\n      supplier_name: supplierData?.supplier_name || \"Unknown Supplier\",\n      source_type: supplierData?.source_type || \"rss\",\n      source_url: finalSourceUrl, \n      event_date: supplierData?.event_date || new Date().toISOString().split('T')[0],\n      risk_title: aiData.risk_title,\n      risk_category: standardCategory,\n      severity_score: severity,\n      operational_impact_score: impact,\n      urgency_score: urgency,\n      overall_risk_score: parseFloat(overall),\n      confidence_score: Number(aiData.confidence_score) || 0,\n      ai_summary: aiData.ai_summary,\n      recommended_action: aiData.recommended_action,\n      processed_at: processedAt,\n      alert_level:\n        parseFloat(overall) >= 4.5\n          ? 'critical'\n          : parseFloat(overall) >= 3.5\n          ? 'summary'\n          : 'low',\n      summary_status: 'pending',\n      summary_sent_at: '',\n      critical_alert_status:\n        parseFloat(overall) >= 4.5\n          ? 'pending'\n          : 'not_required',\n      critical_alert_sent_at: '',\n      processing_status: parseFailed ? 'parse_error' : 'success',\n      error_message: parseFailed ? parseErrorMessage : '',\n      dedupe_key: finalSourceUrl\n    }\n  };\n});"
      },
