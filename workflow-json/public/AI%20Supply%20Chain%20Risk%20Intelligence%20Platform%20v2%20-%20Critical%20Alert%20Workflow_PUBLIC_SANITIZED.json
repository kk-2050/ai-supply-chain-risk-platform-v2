      "parameters": {
        "jsCode": "// Existing URLs from Google Sheets\nconst existingUrls = $input.all().map(item => item.json.source_url);\n\n// Original RSS items from Clean and Match Supplier\nconst originalItems = $('Match Supplier And Clean News').all();\n\n// Keep only new URLs\nconst newItems = originalItems.filter(item => {\n  const url = item.json.source_url;\n  return !existingUrls.includes(url);\n});\n\n\nreturn newItems;\n"
      },
