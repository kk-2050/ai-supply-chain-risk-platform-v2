      "id": "832209b0-27c1-4a5a-8165-49d94a3f8dae",
      "name": "Generate AI Risk Assessment",
      "credentials": {
        "openAiApi": {
          "id": "kA9mS5H3GRsW03H8",
          "name": "OpenAI account"
        }
