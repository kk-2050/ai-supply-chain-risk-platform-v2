    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const input = $json;\n\nconst aiRaw =\n  input?.output?.[0]?.content?.[0]?.text ||\n  input.message?.content ||\n  input.content ||\n  input.text ||\n  input.response ||\n  JSON.stringify(input);\n\nlet aiData;\n\ntry {\n  aiData = typeof aiRaw === 'string' ? JSON.parse(aiRaw) : aiRaw;\n} catch (e) {\n  aiData = {\n    risk_title: 'Parse error - manual review needed',\n    risk_category: 'Other',\n    severity_score: 1,\n    operational_impact_score: 1,\n    urgency_score: 1,\n    confidence_score: 0,\n    ai_summary: String(aiRaw).substring(0, 200),\n    recommended_action: 'Review raw AI output manually'\n  };\n}\n\nconst supplierData = $('Match Supplier And Clean News').item.json;\n\nconst severity = Number(aiData.severity_score) || 1;\nconst impact = Number(aiData.operational_impact_score) || 1;\nconst urgency = Number(aiData.urgency_score) || 1;\n\nconst overall = (\n  severity * 0.40 +\n  impact * 0.35 +\n  urgency * 0.25\n).toFixed(2);\n\nconst rawCategory = String(aiData.risk_category || '').toLowerCase();\n\nfunction standardizeCategory(category) {\n  if (\n    category.includes('shortage') ||\n    category.includes('supply risk') ||\n    category.includes('market supply') ||\n    category.includes('material') ||\n    category.includes('resource') ||\n    category.includes('semiconductor supply') ||\n    category.includes('supply chain disruption')\n  ) {\n    return 'Supply Shortage';\n  }\n\n  if (\n    category.includes('geopolitical') ||\n    category.includes('political') ||\n    category.includes('war') ||\n    category.includes('conflict') ||\n    category.includes('sanction')\n  ) {\n    return 'Geopolitical';\n  }\n\n  if (\n    category.includes('tariff') ||\n    category.includes('trade') ||\n    category.includes('duty')\n  ) {\n    return 'Tariff';\n  }\n\n  if (\n    category.includes('logistics') ||\n    category.includes('shipping') ||\n    category.includes('freight') ||\n    category.includes('port') ||\n    category.includes('transport')\n  ) {\n    return 'Logistics';\n  }\n\n  if (\n    category.includes('financial') ||\n    category.includes('cost') ||\n    category.includes('price') ||\n    category.includes('currency')\n  ) {\n    return 'Financial';\n  }\n\n  if (\n    category.includes('cyber') ||\n    category.includes('hack') ||\n    category.includes('security')\n  ) {\n    return 'Cybersecurity';\n  }\n\n  if (\n    category.includes('natural disaster') ||\n    category.includes('earthquake') ||\n    category.includes('flood') ||\n    category.includes('typhoon') ||\n    category.includes('hurricane')\n  ) {\n    return 'Natural Disaster';\n  }\n\n  if (\n    category.includes('operational') ||\n    category.includes('shutdown') ||\n    category.includes('factory')\n  ) {\n    return 'Operational Disruption';\n  }\n\n  return 'Other';\n}\n\nconst standardCategory = standardizeCategory(rawCategory);\n\nconst processedAt = (() => {\n  const now = new Date();\n\n  const chicago = new Intl.DateTimeFormat('en-CA', {\n    timeZone: 'America/Chicago',\n    year: 'numeric',\n    month: '2-digit',\n    day: '2-digit',\n    hour: 'numeric',\n    minute: '2-digit',\n    hour12: true\n  }).format(now);\n\n  return chicago.replace(',', '') + ' CST';\n})();\n\nreturn {\n  json: {\n    supplier_id: supplierData.supplier_id,\n    supplier_name: supplierData.supplier_name,\n    source_type: supplierData.source_type,\n    source_url: supplierData.source_url,\n    event_date: supplierData.event_date,\n    risk_title: aiData.risk_title,\n    risk_category: standardCategory,\n    severity_score: severity,\n    operational_impact_score: impact,\n    urgency_score: urgency,\n    overall_risk_score: parseFloat(overall),\n    confidence_score: Number(aiData.confidence_score) || 0,\n    ai_summary: aiData.ai_summary,\n    recommended_action: aiData.recommended_action,\n    processed_at: processedAt,\n    alert_level:\n      parseFloat(overall) >= 4.5\n        ? 'critical'\n        : parseFloat(overall) >= 3.5\n        ? 'summary'\n        : 'low',\n    summary_status: 'pending',\n    summary_sent_at: '',\n    critical_alert_status:\n      parseFloat(overall) >= 4.5\n        ? 'pending'\n        : 'not_required',\n    critical_alert_sent_at: '',\n    processing_status: 'success',\n    error_message: '',\n    dedupe_key: supplierData.source_url\n  }\n};"
      },
