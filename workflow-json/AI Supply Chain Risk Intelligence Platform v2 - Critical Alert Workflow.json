    {
      "parameters": {
        "jsCode": "// Supplier list (fictional - for portfolio demonstration)\nconst suppliers = [\n  { id: 1, name: 'Apex Components Ltd', keywords: ['apex components', 'capacitor', 'inductor'] },\n  { id: 2, name: 'Nova Auto Parts Co', keywords: ['nova auto', 'automotive', 'auto parts', 'vehicle'] },\n  { id: 3, name: 'BioSource Materials', keywords: ['biosource', 'pharmaceutical', 'api ingredient', 'chemical'] },\n  { id: 4, name: 'ChipTech Global', keywords: ['chiptech', 'semiconductor', 'gpu', 'chip', 'microchip'] },\n  { id: 5, name: 'FastRoute Logistics', keywords: ['fastroute', 'logistics', 'freight', 'port', 'shipping'] }\n];\n\nconst rawText = $input.first().json.data || '';\n\n// Extract RSS item blocks\nconst items = rawText.match(/<item>[\\s\\S]*?<\\/item>/g) || [];\n\nfunction cleanXml(text) {\n  if (!text) return '';\n  return text\n    .replace(/<!\\[CDATA\\[/g, '')\n    .replace(/\\]\\]>/g, '')\n    .replace(/<[^>]*>/g, '')\n    .replace(/&amp;/g, '&')\n    .replace(/&quot;/g, '\"')\n    .replace(/&#39;/g, \"'\")\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\nfunction extractTag(item, tag) {\n  const regex = new RegExp(`<${tag}[^>]*>([\\\\s\\\\S]*?)<\\\\/${tag}>`, 'i');\n  const match = item.match(regex);\n  return match ? cleanXml(match[1]) : '';\n}\n\nconst results = [];\n\nfor (const item of items.slice(0, 10)) {\n  const title = extractTag(item, 'title');\n  const description = extractTag(item, 'description');\n  const link = extractTag(item, 'link');\n  const pubDate = extractTag(item, 'pubDate');\n\n  // Age filter: Critical workflow only processes articles from the last 24 hours\n  if (pubDate) {\n    const published = new Date(pubDate);\n    const now = new Date();\n    const hoursOld = (now - published) / (1000 * 60 * 60);\n\n    if (Number.isFinite(hoursOld) && hoursOld > 24) {\n      continue;\n    }\n  }\n\n  const combinedText = `${title}. ${description}`;\n  const lower = combinedText.toLowerCase();\n\n  let matchedSupplier = null;\n\n  for (const s of suppliers) {\n    if (s.keywords.some(k => lower.includes(k))) {\n      matchedSupplier = s;\n      break;\n    }\n  }\n\n  // Broad supply chain keywords for demo matching\n  if (!matchedSupplier && /semiconductor|supply chain|shortage|logistics|shipping|automotive|pharma|tariff|port/.test(lower)) {\n    matchedSupplier = suppliers.find(s => s.name === 'ChipTech Global') || suppliers[3];\n  }\n\n  if (matchedSupplier) {\n    results.push({\n      json: {\n        supplier_id: matchedSupplier.id,\n        supplier_name: matchedSupplier.name,\n        risk_title: title,\n        raw_text: combinedText,\n        source_type: 'rss',\n        source_url: link || 'https://news.google.com/rss',\n        event_date: pubDate ? new Date(pubDate).toISOString().split('T')[0] : new Date().toISOString().split('T')[0]\n      }\n    });\n  }\n}\n//---------------------------------------------------------------------------\n//Fallback\n// if (results.length === 0) {\n//   results.push({\n//     json: {\n//       supplier_id: 4,\n//       supplier_name: 'ChipTech Global',\n//       risk_title: 'Sample semiconductor supply disruption',\n//       raw_text: 'Sample: ChipTech Global reported a major semiconductor production shutdown in Taiwan. The disruption may delay critical microchip shipments for automotive and electronics customers.',\n//       source_type: 'rss',\n//       source_url: 'https://example.com/sample-news',\n//       event_date: new Date().toISOString().split('T')[0]\n//     }\n//   });\n// }\n\nreturn results;"
      },
