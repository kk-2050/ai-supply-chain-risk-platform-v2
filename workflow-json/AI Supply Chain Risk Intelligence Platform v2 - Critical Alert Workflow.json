        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You are a supply chain risk analyst.\n\nAnalyze the given supplier risk news and return ONLY valid JSON.\n\nRequired JSON fields:\n- risk_title\n- risk_category\n- severity_score\n- operational_impact_score\n- urgency_score\n- confidence_score\n- ai_summary\n- recommended_action\n\nRules:\n- severity_score: 1-5\n- operational_impact_score: 1-5\n- urgency_score: 1-5\n- confidence_score: 0-100\n- Return only JSON\n- No markdown\n- No explanation"
            },
